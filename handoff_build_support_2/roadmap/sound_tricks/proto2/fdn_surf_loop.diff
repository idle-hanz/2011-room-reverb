+    z = np.exp(-1j * 2 * np.pi * np.asarray(f, float) / sr)
+    return 20 * np.log10(np.abs((c[0] + c[1] * z + c[2] * z * z) / (1 + c[3] * z + c[4] * z * z)) + 1e-300)
