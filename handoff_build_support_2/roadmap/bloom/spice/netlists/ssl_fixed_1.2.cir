* ssl_fixed_1.2
.include /workspace/compressors/spice/models/devices.lib
Vin in 0 SIN(0 4.0 500 0 0 0)
Vgate g1 0 PWL(0 1 0.5 1 0.5001 0)
Bout out 0 V=v(in)*v(g1)*exp(-20.0*0.11513*v(n1))
Brect r 0 V=abs(v(out))-0.7532145960034751
D1 r d DSIG
Ra d n1 8200.0
C1 n1 0 0.47u
R9 n1 0 1200000.0

.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2e-05 4.384 0 2e-05
wrdata /workspace/compressors/spice/raw/ssl_fixed_1.2.txt v(n1) v(out)
quit
.endc
.end
