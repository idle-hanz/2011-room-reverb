+def _surf_bus(taps, n_lines, line_t60):
+    """SL2/SL4: per-bus surf dict for FDN, or None (Flat 2011 / lock off). Hits = faces of each line's image."""
+    ctx = _SURF_CTX.get()
+    if ctx is None or float(line_t60) <= 0.05:
+        return None
+    from surface_colour import surfaces_hit_by_n
+    n_t = len(taps) if taps is not None else 0
+    hits = [surfaces_hit_by_n(taps[i % n_t].n) for i in range(int(n_lines))] if n_t else [[] for _ in range(int(n_lines))]
+    return dict(ctx, hits=hits)
