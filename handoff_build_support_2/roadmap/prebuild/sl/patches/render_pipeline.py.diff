+@_ft.wraps(_render_core)
+def render(*args, **kw):
+    """Render entry point. decay_mode "flat" (default, Flat 2011) calls _render_core unchanged.
+    decay_mode "surfaces" (SL2/SL4/SL5) designs per-line attenuation sections from the Surfaces table
+    (+ Treatment rows, directional rates, optional Render calibration) and passes them to every FDN bus."""
+    if str(kw.get("decay_mode") or "flat").lower() != "surfaces":
+        return _render_core(*args, **kw)
+    import surf_loop as _SLP
+    import surf_panels as _SP
+    import surf_target as _STG
+    ba = _insp.signature(_render_core).bind(*args, **kw)
+    ba.apply_defaults()
+    a = ba.arguments
+    W, H, L = float(a["W"]), float(a["H"]), float(a["L"])
+    surfaces = parse_surfaces(a["surfaces"]) if a["surfaces"] is not None else default_surfaces()
+    cards = _SP.cards_with_treatment(surfaces, a.get("surf_treatment") or [])
+    hum = float(a["humidity"] or 0.0)
+    if any("absorb_fn" in c for c in cards.values()):
+        # Treatment is part of the face: early reflections and the FDN injection see the treated
+        # octave alpha as well (as the box prototype did), not only the loop.
+        from surface_colour import ABSORB_BAND_HZ as _BH
+        a["surfaces"] = {k: (dict(surfaces[k], absorb=[round(float(x), 4) for x in cards[k]["absorb_fn"](np.asarray(_BH, float))])
+                             if "absorb_fn" in cards[k] else surfaces[k]) for k in surfaces}
+    anchor = float(a["decay_s"]) if (a["decay_lock"] and float(a["decay_s"] or 0.0) > 0.05) else None
+    if anchor is None:   # lock off: absolute length from the materials, the dial shows the result
+        a["decay_s"] = float(np.mean(_STG.room_target(W, H, L, cards, hum, np.array([500.0, 1000.0]))))
+        a["decay_lock"] = True
+    spec = _SLP.make_spec(W, H, L, cards, hum, anchor, directional=bool(a.get("surf_directional", True)),
+                          cal=a.get("surf_cal"))
+    tok = _SURF_CTX.set(spec)
+    try:
+        y_l, y_r, info = _render_core(*ba.args, **ba.kwargs)
+    finally:
+        _SURF_CTX.reset(tok)
+    info = dict(info or {})
+    info["surf"] = dict(decay_mode="surfaces", target_T_oct=spec["target_T_oct"], anchor_s=anchor,
+                        decay_s_used=float(a["decay_s"]), directional=spec["directional"],
+                        cal=a.get("surf_cal"), buses=spec["report"])
+    return y_l, y_r, info
+
