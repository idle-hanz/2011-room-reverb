+# ---- BOX-ONLY PROTOTYPE (scratch copy, not software\): rotating FWHT stage ----
+import os as _os
+_ROT_EPS = float(_os.environ.get("ROT_EPS", "0"))      # fraction of pi
+_ROT_HZ = float(_os.environ.get("ROT_HZ", "0.3"))
+_ROT_H = int(_os.environ.get("ROT_STAGE", "16"))       # butterfly distance of the rotated stage
+_ROT_SR = 48000.0
+_GUITAR = _os.environ.get("GUITAR_NPY")
+
+
+def _rot_mix(H, v, n_abs):
+    """H·D·v as an in-place Sylvester FWHT; stage _ROT_H uses Ref(theta), theta = pi/4 + eps*pi*sin(2 pi f t).
+    Unscaled like H: a stage is sqrt2*[[c, s], [s, -c]] (= [[1,1],[1,-1]] at pi/4). Orthogonal at every t."""
+    if _ROT_EPS == 0.0 or H.shape[0] != 32:
+        return H @ v
+    x = v * LOOP_COLUMN_D
+    th = math.pi / 4 + _ROT_EPS * math.pi * math.sin(2 * math.pi * _ROT_HZ * n_abs / _ROT_SR)
+    c = math.sqrt(2.0) * math.cos(th); s = math.sqrt(2.0) * math.sin(th)
+    h = 1
+    while h < 32:
+        a = x.reshape(-1, 2, h)
+        u = a[:, 0, :].copy(); w = a[:, 1, :].copy()
+        if h == _ROT_H:
+            a[:, 0, :] = c * u + s * w
+            a[:, 1, :] = s * u - c * w
+        else:
+            a[:, 0, :] = u + w
+            a[:, 1, :] = u - w
+        x = a.reshape(32)
+        h *= 2
+    return x
+
+# ---- BOX-ONLY PROTOTYPE 2: Frenette delay modulation + Dffs cap ----
+_MOD_MS = float(_os.environ.get("MOD_MS", "0"))      # peak depth in ms (0 = off)
+_MOD_HZ = float(_os.environ.get("MOD_HZ", "0.7"))    # base rate
+_DCAP = float(_os.environ.get("DCAP", "0"))          # |Dffs| cap (0 = off)
+
+
+def _mod_setup(delays, sr):
+    """16 of 32 lines (every other line by sorted length); rate = base x 0.6..1.4 (irrational spread);
+    phase k*112.5 deg (adjacent modulated lines 112.5 deg apart, 16 distinct phases)."""
+    n = len(delays)
+    if _MOD_MS <= 0.0 or n != 32:
+        return None
+    order = sorted(range(n), key=lambda i: (delays[i], i))
+    lines = order[1::2]
+    A = _MOD_MS * 1e-3 * sr
+    cfg = {}
+    for k, i in enumerate(lines):
+        r = 0.6 + 0.8 * ((k * 0.6180339887498949) % 1.0)
+        cfg[i] = (A, 2 * math.pi * _MOD_HZ * r / sr, math.radians(112.5 * k))
+    L = int(max(delays)) + int(A) + 8
+    return dict(cfg=cfg, hist={i: np.zeros(L) for i in cfg}, hp={i: 0 for i in cfg}, yap={i: 0.0 for i in cfg}, L=L)
+
