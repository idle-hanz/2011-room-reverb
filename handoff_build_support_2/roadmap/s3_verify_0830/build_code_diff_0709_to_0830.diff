+    e = _norm((
+        float(mic[0]) - float(source[0]),
+        float(mic[1]) - float(source[1]),
+        float(mic[2]) - float(source[2]),
+    ))
+    loc = local_dir(e, facing_basis(yaw_deg, pitch_deg))
