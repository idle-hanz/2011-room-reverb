+    src = packed.get('src_rad') or []
+    if len(src) != 716 or src[0] < 0.5 or src[1] < 0.5:
+        raise AssertionError(f'SRC_RAD not live for both sources (len {len(src)}, head {src[:2]})')
+    r = json.loads(ctx.play(p, {}, 'bench', 4, 10))
+    ms, sil = r['play_mean_ms'], r['silence_late_mean_ms']
+    limit = 0.80 * BUDGET_MS * ctx.perf_scale
+    res = {'play_mean_ms': round(ms, 3), 'silence_late_mean_ms': round(sil, 3), 'limit_ms': round(limit, 3)}
+    if ms > limit:
