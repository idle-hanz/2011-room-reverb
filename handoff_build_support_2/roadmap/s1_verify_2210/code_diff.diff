+            core += [1.0, _pb_num(pk.get("b0"), 1.0), _pb_num(pk.get("b1"), 0.0),
+                     _pb_num(pk.get("b2"), 0.0), _pb_num(pk.get("a1"), 0.0), _pb_num(pk.get("a2"), 0.0)]
+        else:
